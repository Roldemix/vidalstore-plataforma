# Versiones desplegadas. Se cambia SOLO por merge a main: el flujo
# .github/workflows/desplegar.yml lee este archivo y actualiza cada maquina.
# Cada valor es el tag publicado por el imagen.yml del repositorio respectivo
# (el SHA del commit que se quiere ejecutar). Antes de la primera entrega hay
# que reemplazar `latest` por los SHA reales.
REGISTRO=ghcr.io/roldemix

GATEWAY_VERSION=latest
BFF_VERSION=latest
CATALOGO_VERSION=latest
LICENCIAS_VERSION=latest
EVENTOS_VERSION=latest
ADMIN_VERSION=latest
FRONTEND_VERSION=latest
