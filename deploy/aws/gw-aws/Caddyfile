# Borde de AWS. Dominio <elastic-ip-con-guiones>.sslip.io (variable DOMINIO,
# la escribe el workflow a partir de vars.AWS_URL). Certificado automatico.
# 443 solo acepta a gw-azure (Security Group); 80 queda abierto para el reto ACME.
# La administracion (3020) NO se publica: solo por tunel de Session Manager.
{
	# PRUEBAS (staging): sin limite de emision. Cuando el cert de pruebas salga
	# bien, COMENTAR esta linea, hacer merge y el workflow reinicia Caddy.
	# NO borrar el volumen /data.
	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMINIO} {
	encode zstd gzip

	handle /v1/* {
		reverse_proxy 10.0.11.10:8080
	}

	respond "No encontrado" 404
}
